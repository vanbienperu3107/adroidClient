<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- OpenCode profile/vault state is stored under noBackupFilesDir. Keep
         existing GPT Mobile backup behavior unchanged; do not add a global
         include rule that would exclude legacy data. -->
    <exclude domain="file" path="opencode-vault/" />
    <exclude domain="file" path="opencode-profiles.preferences_pb" />
</full-backup-content>
